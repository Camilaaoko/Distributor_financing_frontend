# Base URL for the backend API Gateway. Copy this file to .env.local and adjust as needed.
NEXT_PUBLIC_API_URL=http://172.16.3.60:8080/api

# Base URL for the Notifications Service (separate from main API)
NEXT_PUBLIC_NOTIFICATIONS_API_URL=http://172.16.3.60:8080/api/notifications

# When true, modules whose backend endpoints aren't live yet fall back to in-memory mock data.
# Set to false once the corresponding backend endpoints ship.
NEXT_PUBLIC_USE_MOCKS=false
